# Bearer token clients must send as `Authorization: Bearer <token>`.
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
MEMORY_TOKEN=

# Where the markdown files live (relative to project root or absolute).
MEMORY_DIR=memory

# Bind address and port.
HOST=127.0.0.1
PORT=3333

# Set to true when the server is behind a reverse proxy that forwards the
# public hostname (e.g. Tailscale Funnel). Disables the DNS-rebinding
# Host-header check so the proxied requests aren't rejected. Bearer auth
# still gates access; this only relaxes the Host check.
TRUST_PROXY=false

# Canonical URL clients reach the server at, advertised in the RFC 9728 auth
# metadata. REQUIRED when behind a proxy or tunnel: without it the metadata
# advertises the loopback bind address and auth-discovering clients can't
# connect. Defaults to http://HOST:PORT.
# PUBLIC_URL=https://your-host.ts.net/mcp
